{{- $taxonomy := .Data.Plural -}}
{{- $title := printf "%s | %s" (title $taxonomy) .Site.Title -}}

<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $title }}</title>
    <link>{{ .Permalink }}</link>
    <description>All {{ $taxonomy }} on {{ .Site.Title }}</description>
    <language>{{ .Site.Language.Lang }}</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>

    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />

    {{ range .Data.Terms.Alphabetical }}
    <item>
      <title>{{ .Page.Title }}</title>
      <link>{{ .Page.Permalink }}</link>
      <guid>{{ .Page.Permalink }}</guid>
      <description>
        {{- if .Page.Params.description -}}
          {{ .Page.Params.description | plainify }}
        {{- else -}}
          {{ printf "Posts filed under %s" .Page.Title }}
        {{- end -}}
      </description>
    </item>
    {{ end }}

  </channel>
</rss>